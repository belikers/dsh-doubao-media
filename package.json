{
  "name": "dsh-doubao-media",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "DeepSeek Harness 插件：接入火山方舟豆包 Seedream / Seedance，在会话里生成图片和视频",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belikers/dsh-doubao-media.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "doubao",
    "seedream",
    "seedance",
    "volcengine",
    "ark"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
